{
  "dataset_id": "day04_v3_helpdesk_group",
  "dataset_role": "group",
  "description": "10 original IT helpdesk cases authored by the team: 5 single-turn query cases and 5 multi-turn turns cases.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_service_and_device_parallel",
      "phase": "B",
      "suite": "group",
      "query": "Kiểm tra trạng thái SSO production và chẩn đoán phần cứng máy LT-204 giúp tôi.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "check_service_status",
            "args": {
              "service": "sso",
              "environment": "production"
            }
          },
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "LT-204",
              "check": "hardware"
            }
          }
        ]
      },
      "metadata": {
        "skill": "parallel_service_device",
        "difficulty": "hard",
        "what_it_tests": "Một yêu cầu gồm cả service SSO và phần cứng thiết bị LT-204 cần gọi đồng thời 2 tool tương ứng."
      }
    },
    {
      "id": "G02_ambiguous_env_wifi",
      "phase": "B",
      "suite": "group",
      "query": "Hệ thống Wi-Fi ở môi trường test nội bộ hiện có bị chập chờn không?",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "choice",
              "options": [
                "production",
                "staging"
              ]
            }
          }
        ]
      },
      "metadata": {
        "skill": "clarify_environment",
        "difficulty": "medium",
        "what_it_tests": "Môi trường test không nằm trong enum hợp lệ, bắt buộc clarify chọn production hoặc staging."
      }
    },
    {
      "id": "G03_out_of_scope_weather",
      "phase": "B",
      "suite": "group",
      "query": "Dự báo thời tiết Hà Nội hôm nay trời có mưa không bạn?",
      "failure_type": "out_of_scope",
      "expect": {
        "no_tool": true,
        "behavior": "refuse"
      },
      "metadata": {
        "skill": "out_of_scope",
        "difficulty": "easy",
        "what_it_tests": "Câu hỏi thời tiết nằm ngoài phạm vi IT service desk, từ chối và không được gọi tool."
      }
    },
    {
