      "metadata": {
        "skill": "policy_lookup",
        "difficulty": "medium",
        "what_it_tests": "Câu hỏi về chính sách kiểm soát truy cập phải gọi policy với policy_area=access_control."
      }
    },
    {
      "id": "G05_search_device_specs_public",
      "phase": "B",
      "suite": "group",
      "query": "Tra cứu thông số kỹ thuật công khai của dòng laptop Dell Latitude 5420.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "search_device_info",
