      "phase": "B",
      "suite": "group",
      "query": "Kiểm tra xem trạm ST-303 hiện tại còn cổng sạc nào trống và giá điện bao nhiêu.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "check_station_status",
