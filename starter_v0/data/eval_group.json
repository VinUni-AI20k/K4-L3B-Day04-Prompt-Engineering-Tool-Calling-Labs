{
  "dataset_id": "day04_v3_helpdesk_group",
  "dataset_role": "group",
  "description": "Original group evaluation cases for IT Helpdesk Agent: 5 single-turn and 5 multi-turn cases covering service checks, device inspection, policy routing, missing info clarification, and write boundaries.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_check_printer_status",
      "phase": "B",
      "suite": "group",
      "query": "Kiểm tra tình trạng dịch vụ in ấn printing trên production hiện tại.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "check_service_status",
            "args": {
              "service": "printing",
              "environment": "production"
            }
          }
        ]
      },
      "metadata": {
        "skill": "route_shared_service",
        "difficulty": "easy",
        "what_it_tests": "Kiểm tra trạng thái dịch vụ in ấn dùng chung phải gọi check_service_status."
      }
    },
    {
      "id": "G02_inspect_printer_hardware",
      "phase": "B",
      "suite": "group",
      "query": "Kiểm tra tình trạng phần cứng máy in PR-404 giúp mình.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "PR-404",
              "check": "hardware"
            }
          }
        ]
      },
      "metadata": {
        "skill": "device_check_arg",
        "difficulty": "medium",
        "what_it_tests": "Yêu cầu kiểm tra thiết bị cụ thể PR-404 với check=hardware."
      }
    },
    {
      "id": "G03_policy_external_tools",
      "phase": "B",
      "suite": "group",
      "query": "Tìm quy định công ty về việc sử dụng phần mềm bên ngoài external tools.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "policy",
            "args": {
              "policy_area": "external_tools"
            }
          }
        ]
      },
      "metadata": {
        "skill": "route_policy",
        "difficulty": "medium",
        "what_it_tests": "Tra cứu quy định công ty phải định tuyến đúng policy_area external_tools."
      }
    },
    {
