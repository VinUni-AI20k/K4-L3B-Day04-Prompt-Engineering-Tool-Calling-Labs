{
  "dataset_id": "day04_v0_smartcharging_group",
  "dataset_role": "group",
  "description": "10 original SmartCharging test cases authored by team Si và Bảy: 5 single-turn cases and 5 multi-turn cases.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "GRP01_lowest_cost_rush_hour",
      "phase": "B",
      "suite": "group",
      "query": "Xe EV-101 đang 20% pin, muốn sạc lên 75% trước 18:00 ngày 15/09/2026 UTC+07, xuất phát từ Quận 1. Tìm phương án tiết kiệm nhất.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "find_charging_offers",
            "args": {
              "vehicle_id": "EV-101",
              "current_soc": 20,
              "target_soc": 75,
              "deadline": "2026-09-15T18:00:00+07:00",
              "origin": "Quận 1",
              "preference": "lowest_cost"
            }
          }
        ]
      },
      "metadata": {
        "difficulty": "easy",
        "what_it_tests": "Tìm phương án sạc với tiêu chí chi phí thấp nhất (lowest_cost)."
      }
    },
    {
      "id": "GRP02_lookup_vehicle_specs",
      "phase": "B",
      "suite": "group",
      "query": "Cho tôi xem thông số kỹ thuật, chuẩn sạc và công suất tối đa của xe EV-202.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup_vehicle",
            "args": {
              "vehicle_id": "EV-202"
            }
          }
        ]
      },
      "metadata": {
        "difficulty": "easy",
        "what_it_tests": "Tra cứu thông tin pin và chuẩn sạc của xe EV-202."
      }
    },
    {
